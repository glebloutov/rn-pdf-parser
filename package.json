{
  "name": "rn-pdf-parser",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "android:reverse": "adb reverse tcp:8787 tcp:8787",
    "android:emulator": "sh scripts/android-emulator.sh",
    "android:dev": "sh scripts/android-emulator.sh && react-native run-android",
    "mock": "npm --prefix mock-server start",
    "mock:test": "npm --prefix mock-server test",
    "mock:oversize": "npm --prefix mock-server run fixtures:oversize",
    "mock:state": "node scripts/mock-control.mjs state",
    "mock:reset": "node scripts/mock-control.mjs reset",
    "mock:scenario": "node scripts/mock-control.mjs scenario",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ui": "jest --selectProjects ui",
    "test:report": "jest --json --outputFile=docs/test-results/jest-results.json && node scripts/sanitize-test-report.mjs",
    "e2e:fixtures:android": "sh .maestro/scripts/push-fixtures-android.sh",
    "e2e:fixtures:ios": "sh .maestro/scripts/push-fixtures-ios.sh",
    "e2e:android": "sh .maestro/scripts/push-fixtures-android.sh && sh scripts/maestro.sh test -p android --format junit --output docs/test-results/maestro-android.xml .maestro",
    "e2e:ios": "sh scripts/maestro.sh test -p ios --format junit --output docs/test-results/maestro-ios.xml .maestro",
    "archive": "sh scripts/make-archive.sh"
  },
  "dependencies": {
    "@react-native-documents/picker": "12.0.2",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "i18next": "26.4.4",
    "react": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.87.1",
    "react-native-file-access": "4.0.4",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "10.0.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-unistyles": "3.5.3",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "react-native-dotenv": "5.0.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >= 26.0.0"
  }
}
