# Copy to .env only if the default doesn't fit, then restart Metro: npm start -- --reset-cache
# Default (no .env): http://127.0.0.1:8787 — iOS Simulator, Android emulator with `npm run android:reverse`.
# Physical device: your computer's LAN IP, and start the mock with HOST=0.0.0.0 npm run mock
# Android emulator without adb reverse: http://10.0.2.2:8787
MOCK_API_URL=http://127.0.0.1:8787
